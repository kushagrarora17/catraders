subscription_id = "00000000-0000-0000-0000-000000000000"

# Internal inbox for new-RFQ notifications.
quote_notification_email = "sales@example.com"

# Your public IP, to run `bun run db:migrate` against Azure Postgres by hand.
# The web app is allowed via its possible outbound IPs. postgres_allow_azure_services
# defaults to false, so the 0.0.0.0 "allow Azure services" rule stays off.
# github-runner-* rules are temporary and are not listed here.
# postgres_allow_azure_services = false
# postgres_allowed_ip_ranges = {
#   admin-home = { start_ip_address = "203.0.113.10", end_ip_address = "203.0.113.10" }
# }

# MCP server (catalog & RFQ management at /api/mcp). The sign-in password and token-signing secret
# are generated automatically. To let it edit Sanity content, create an Editor token at
# sanity.io/manage → API → Tokens, then:
#   export TF_VAR_sanity_write_token=sk...   # ephemeral: never written to state; needed on every plan/apply
#   sanity_write_token_version = 1           # bump this (with a new token) to rotate
# sanity_write_token_version = 1

# Custom domain behind Cloudflare (see iac/README.md). First apply with only the object ID, import the
# origin certificate, then set custom_domain and site_url and apply again.
#   az ad sp show --id abfa0a7c-a6b6-4736-8310-5855508787cd --query id -o tsv
# app_service_rp_object_id = "00000000-0000-0000-0000-000000000000"
# custom_domain            = "example.com"
# site_url                 = "https://example.com"
