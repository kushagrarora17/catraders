# ── Sanity ────────────────────────────────────────────────────────────────
# Public project details (defaults are baked in; override per environment).
SANITY_PROJECT_ID=51ngrb7a
SANITY_DATASET=production
# Only needed if the dataset is private (Viewer token from sanity.io/manage).
SANITY_API_READ_TOKEN=
# Secret configured on the Sanity GROQ webhook (used to verify its signature).
SANITY_WEBHOOK_SECRET=change-me

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Local (bun run db:up):
DATABASE_URL=postgres://catraders:catraders@localhost:5432/catraders
# Azure Database for PostgreSQL example:
# DATABASE_URL=postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=verify-full

# ── Azure Communication Services (email) ─────────────────────────────────
# Leave blank locally: emails are logged and skipped.
AZURE_COMMUNICATION_CONNECTION_STRING=
# Verified sender, e.g. DoNotReply@<guid>.azurecomm.net
EMAIL_SENDER_ADDRESS=
# Internal inbox that receives new-RFQ notifications.
QUOTE_NOTIFICATION_EMAIL=

# ── MCP server (/api/mcp) ─────────────────────────────────────────────────
# Leave unset to keep the endpoint off (it answers 503).
# Password asked for on the OAuth sign-in screen.
MCP_ADMIN_PASSWORD=
# Signs access tokens; at least 32 random characters (e.g. `openssl rand -hex 32`).
MCP_JWT_SECRET=
# Sanity API token with the Editor role, for the catalog and review tools.
SANITY_API_WRITE_TOKEN=

# ── Site ──────────────────────────────────────────────────────────────────
# Public URL for canonical links, Open Graph, sitemap.xml and robots.txt.
SITE_URL=http://localhost:3000
