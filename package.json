{
  "name": "catraders",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:policy": "bun scripts/check-policy.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit": "fallow --format json --quiet --explain --fail-on-issues --fail-on-parse-error",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun --env-file=.env.local test",
    "test:e2e": "rm -rf coverage/e2e-raw && playwright test && bun e2e/coverage-report.ts",
    "db:up": "sh scripts/db-up.sh",
    "db:down": "${CONTAINER_CLI:-podman} stop catraders-postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "studio:dev": "cd studio && bun run dev",
    "typegen": "cd studio && bun run typegen",
    "mcp:operator": "bun scripts/manage-mcp-operator.ts",
    "seed": "cd studio && bun run seed",
    "upload-products": "cd studio && bun run upload-products",
    "review:build": "bun build workers/content-review/index.ts --target node --packages bundle --external @azure/functions --outdir workers/content-review/dist && bun workers/content-review/build.ts",
    "review:test:model": "bun scripts/test-foundry-model.ts",
    "review:test:research": "bun scripts/test-foundry-research.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/functions": "^4.17.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-queue": "^12.32.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/webhook": "^4.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "groq": "^6.22.0",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "posthog-js": "^1.445.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fallow": "3.39.0",
    "groq-js": "2.0.1",
    "monocart-coverage-reports": "2.13.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=24"
  }
}
